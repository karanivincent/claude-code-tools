{
 "SM-01": [
  {
   "text": "23",
   "kind": "computed",
   "how": "Badge count on a sidebar item (Home or Calls: ambiguous from text order); a count of open items for the org, no single column",
   "note": "unsure which nav item owns it"
  },
  {
   "text": "3",
   "kind": "computed",
   "how": "Badge on Knowledge: count of knowledge suggestions awaiting approval (org_knowledge / knowledge_sources rows for the org)",
   "note": "unsure of exact status filter"
  },
  {
   "text": "RW",
   "kind": "computed",
   "how": "Initials of the signed-in user: first letters of users.full_name"
  },
  {
   "text": "Ruth Wairimu",
   "kind": "column",
   "table": "users",
   "column": "full_name",
   "where": "the signed-in user (users.id = auth user)"
  },
  {
   "text": "Owner",
   "kind": "column",
   "table": "organization_members",
   "column": "role",
   "where": "the signed-in user in the current org (not users.role, which is a platform role)"
  },
  {
   "text": "RW",
   "kind": "computed",
   "how": "Initials from users.full_name"
  },
  {
   "text": "Ruth Wairimu",
   "kind": "column",
   "table": "users",
   "column": "full_name",
   "where": "the member user (organization_members.user_id = users.id)"
  },
  {
   "text": "You",
   "kind": "computed",
   "how": "shown when organization_members.user_id equals the signed-in user id"
  },
  {
   "text": "ruth@example.com",
   "kind": "column",
   "table": "users",
   "column": "email",
   "where": "the member user"
  },
  {
   "text": "Owner",
   "kind": "column",
   "table": "organization_members",
   "column": "role",
   "where": "the member row"
  },
  {
   "text": "JN",
   "kind": "computed",
   "how": "Initials from users.full_name"
  },
  {
   "text": "James Ndirangu",
   "kind": "column",
   "table": "users",
   "column": "full_name",
   "where": "the member user (organization_members.user_id = users.id)"
  },
  {
   "text": "james@example.com",
   "kind": "column",
   "table": "users",
   "column": "email",
   "where": "the member user"
  },
  {
   "text": "Admin",
   "kind": "column",
   "table": "organization_members",
   "column": "role",
   "where": "the member row"
  },
  {
   "text": "MA",
   "kind": "computed",
   "how": "Initials from users.full_name"
  },
  {
   "text": "Mercy Akinyi",
   "kind": "column",
   "table": "users",
   "column": "full_name",
   "where": "the member user (organization_members.user_id = users.id)"
  },
  {
   "text": "mercy@example.com",
   "kind": "column",
   "table": "users",
   "column": "email",
   "where": "the member user"
  },
  {
   "text": "Member",
   "kind": "column",
   "table": "organization_members",
   "column": "role",
   "where": "the member row"
  },
  {
   "text": "PK",
   "kind": "computed",
   "how": "Initials from users.full_name"
  },
  {
   "text": "Peter Kariuki",
   "kind": "column",
   "table": "users",
   "column": "full_name",
   "where": "the member user (organization_members.user_id = users.id)"
  },
  {
   "text": "peter@example.com",
   "kind": "column",
   "table": "users",
   "column": "email",
   "where": "the member user"
  },
  {
   "text": "Member",
   "kind": "column",
   "table": "organization_members",
   "column": "role",
   "where": "the member row"
  },
  {
   "text": "B",
   "kind": "computed",
   "how": "Initial of organization_invitations.email (no name exists for an invitee)"
  },
  {
   "text": "brian@example.com",
   "kind": "column",
   "table": "organization_invitations",
   "column": "email",
   "where": "pending invitation row (accepted_at and revoked_at null)"
  },
  {
   "text": "Invited · expires Wed 24 Sep",
   "kind": "column",
   "table": "organization_invitations",
   "column": "expires_at",
   "where": "pending row with expires_at in the future; formatted date",
   "time": true
  },
  {
   "text": "Member",
   "kind": "column",
   "table": "organization_invitations",
   "column": "role",
   "where": "the pending invitation row"
  },
  {
   "text": "S",
   "kind": "computed",
   "how": "Initial of organization_invitations.email"
  },
  {
   "text": "susan@example.com",
   "kind": "column",
   "table": "organization_invitations",
   "column": "email",
   "where": "invitation row whose expires_at is past"
  },
  {
   "text": "Expired",
   "kind": "computed",
   "how": "derived: organization_invitations.expires_at < now() and not accepted or revoked",
   "time": true
  },
  {
   "text": "Member",
   "kind": "column",
   "table": "organization_invitations",
   "column": "role",
   "where": "the expired invitation row"
  }
 ],
