{
  "about": "Synthetic twins of the copy leaks a real build shipped (spec 20.2, M7): the same shapes with generic words. The profile lists are the lint's inputs, as a profile would give them.",
  "profile": {
    "bannedWords": ["approve", "approved", "archive", "archived", "persona", "personas", "loopback"],
    "developerPhrases": ["spec §", "design spec", "not built", "this PR", "TODO", "FIXME", "lorem"],
    "dateShape": "D Mon"
  },
  "mustFlag": [
    { "text": "Add one order at a time. Today's list came in at —.", "rules": ["leak-dash-in-sentence"], "matches": ["at —."] },
    { "text": "No orders yet on .", "rules": ["leak-preposition-punctuation"], "matches": ["on ."] },
    { "text": "Try 1 more time. Then Home: \"\".", "rules": ["leak-empty-quotes"], "notRules": ["count-one-plural"], "matches": ["\"\""] },
    { "text": "Order history · 1 orders", "rules": ["count-one-plural"], "matches": ["1 orders"] },
    { "text": "Ring ·", "rules": ["spacing"], "matches": [" ·"] },
    { "text": "Acme rings . 0 of 20 minutes used today.", "rules": ["spacing"], "matches": [" ."] },
    { "text": "Acme rings . Your phone will show , the number people see.", "rules": ["spacing"], "matches": [" .", " ,"] },
    { "text": "Voice: 0f8fad5b-d9cb-469f-a165-70867728950e → —", "rules": ["uuid"], "matches": ["0f8fad5b-d9cb-469f-a165-70867728950e"] },
    { "text": "Approved", "rules": ["banned-word"], "matches": ["Approved"] },
    { "text": "No personas have been written for this widget yet.", "rules": ["banned-word"], "matches": ["personas"] },
    { "text": "Loopback", "rules": ["banned-word"], "matches": ["Loopback"] },
    { "text": "Off since 8/31/2026", "rules": ["numeric-date"], "matches": ["8/31/2026"] },
    { "text": "Live since 8/31/2026 · 0 orders", "rules": ["numeric-date"], "notRules": ["spacing"], "matches": ["8/31/2026"] },
    { "text": "8/29/2026, 10:46:16 PM", "rules": ["numeric-date"], "matches": ["8/29/2026"] },
    { "text": "Ordering opens here. The dialog itself (design spec §11) is not built by this PR.", "rules": ["developer-phrase"], "matches": ["design spec", "not built", "this PR"] },
    { "text": "widgets.overview.today.title", "rules": ["message-key"], "matches": ["widgets.overview.today.title"] },
    { "text": "Hello {name}, welcome back", "rules": ["leak-token"], "matches": ["{name}"] },
    { "text": "Total: undefined orders", "rules": ["leak-token"], "matches": ["undefined"] },
    { "text": "Shipped on NaN", "rules": ["leak-token"], "matches": ["NaN"] },
    { "text": "Invalid Date", "rules": ["leak-token"], "matches": ["Invalid Date"] },
    { "text": "Due 2026-08-31", "rules": ["numeric-date"], "matches": ["2026-08-31"] },
    { "text": "TODO: write the empty state", "rules": ["developer-phrase"], "matches": ["TODO"] },
    { "text": "Sent to the customer at .", "rules": ["leak-preposition-punctuation"], "matches": ["at ."] },
    { "text": "Opens in — seconds", "rules": ["leak-dash-in-sentence"], "matches": ["in —"] },
    { "text": "a · · b", "rules": ["spacing"], "matches": ["· ·"] },
    { "text": "Name (optional )", "rules": ["spacing"], "matches": [" )"] }
  ],
  "mustNotFlag": [
    { "text": "Turn on", "why": "a preposition ending a label is not a blank" },
    { "text": "Log in", "why": "a preposition ending a label is not a blank" },
    { "text": "Microphone", "why": "a label" },
    { "text": "—", "why": "a lone dash element" },
    { "text": "· no practice calls yet", "why": "a separator starting an element" },
    { "text": "Edited 03:27 PM by Test Robot 17890 · not sent for review", "why": "a separator between two facts" },
    { "text": "1 of 50 moves used today", "why": "the plural noun belongs to 50" },
    { "text": "Try 0 more times, 5 minutes apart.", "why": "grammatical; the plural bug is M8's" },
    { "text": "Order history · 0 orders", "why": "0 takes the plural" },
    { "text": "1 order", "why": "singular" },
    { "text": "1 needs you", "why": "a verb after 1" },
    { "text": "Rang 1555 •••• 0100", "why": "a masked number, not separators" },
    { "text": "Calls finish — then we stop", "why": "a dash between clauses" },
    { "text": "support@example.invalid", "why": "an address, not a key" },
    { "text": "www.example.invalid", "why": "a host, not a key" },
    { "text": "Version 1.2.3", "why": "a version number, not a date" },
    { "text": "Open 24/7", "why": "not a date" },
    { "text": "17 Sep · 14 orders", "why": "the profile's date shape" },
    { "text": "Approval rules", "why": "\"approval\" is not on the list" },
    { "text": "Todo list", "why": "a phrase with capitals matches its capitals" },
    { "text": "Say \"yes\" or \"no\"", "why": "quotes with words inside" },
    { "text": "0.1 seconds", "why": "a decimal, not a count of one" }
  ]
}
