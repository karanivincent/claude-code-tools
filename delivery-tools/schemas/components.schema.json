{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-tools.invalid/schemas/components.schema.json",
  "title": "Component map (docs/delivery/components.json, spec components-first §2)",
  "description": "One file for the whole product, shared by every run: every component Claude Design named (kind design) and the shadcn-style base parts it composes (kind base). Its own version key is \"version\", not \"schemaVersion\": it is never a per-run artefact, so there is nothing for a run to stamp.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "version": { "const": 1 },
    "allowOwns": {
      "description": "Files allowed to import an owned library although they are not that library's target.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "library", "why"],
        "properties": {
          "file": { "$ref": "common.schema.json#/$defs/Text" },
          "library": { "$ref": "common.schema.json#/$defs/Text" },
          "why": { "$ref": "common.schema.json#/$defs/Text" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/Component" }
    }
  },
  "$defs": {
    "Component": {
      "anyOf": [{ "$ref": "#/$defs/DesignComponent" }, { "$ref": "#/$defs/BaseComponent" }]
    },
    "DesignComponent": {
      "description": "A component Claude Design named with a dc-import. Only intake and land write status, builtHash and design; the mapper agent writes target, props, owns, builtOn, replaces and allowOwns (briefs/components-mapper.md).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "design", "target", "status", "builtHash", "props", "owns", "builtOn", "replaces", "uses", "states"],
      "properties": {
        "kind": { "const": "design" },
        "name": { "$ref": "common.schema.json#/$defs/Text" },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "hash"],
          "properties": {
            "file": { "$ref": "common.schema.json#/$defs/Text" },
            "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "target": {
          "description": "null until the mapper picks one: an existing file rebuilt in place, or a new path under baseDir.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "status": { "enum": ["new", "built", "stale"] },
        "builtHash": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "props": {
          "description": "Design prop name to code prop name.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "owns": { "$ref": "common.schema.json#/$defs/Strings" },
        "builtOn": {
          "description": "The base entries (by name) this component composes.",
          "$ref": "common.schema.json#/$defs/Strings"
        },
        "replaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReplacesItem" }
        },
        "uses": { "$ref": "common.schema.json#/$defs/Strings" },
        "states": { "$ref": "common.schema.json#/$defs/Strings" }
      }
    },
    "BaseComponent": {
      "description": "A shadcn-style part the design components are built from. Never built or pictured by a run; generated by delivery components --scan-base.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "target", "owns", "source"],
      "properties": {
        "kind": { "const": "base" },
        "name": { "$ref": "common.schema.json#/$defs/Text" },
        "target": { "$ref": "common.schema.json#/$defs/Text" },
        "owns": { "$ref": "common.schema.json#/$defs/Strings" },
        "source": { "enum": ["scan", "shadcn"] }
      }
    },
    "ReplacesItem": {
      "description": "A repo file that is the same control built again. left requires a non-empty why.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "state"],
      "properties": {
        "file": { "$ref": "common.schema.json#/$defs/Text" },
        "state": { "enum": ["open", "retired", "left"] },
        "why": { "type": ["string", "null"] }
      },
      "anyOf": [
        { "properties": { "state": { "enum": ["open", "retired"] } } },
        {
          "properties": { "state": { "const": "left" }, "why": { "type": "string", "minLength": 1 } },
          "required": ["why"]
        }
      ]
    }
  }
}
