{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://delivery-tools.invalid/schemas/seedplan.schema.json",
  "title": "Seed plan (.delivery/<feature>/seedplan.json)",
  "description": "Every fixture row and user the run will write, with deterministic ids (spec 7.4, 17.9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "project",
    "worlds",
    "rows",
    "users"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "$ref": "common.schema.json#/$defs/FileId"
    },
    "project": {
      "$ref": "common.schema.json#/$defs/Text"
    },
    "worlds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "orgId"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/FileId"
          },
          "orgId": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "globals": {
            "description": "R7: shared tables the world reads but does not own; seed --apply hashes them into globals.json and shoot warns when one changed.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table"
              ],
              "properties": {
                "table": {
                  "type": "string"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "world",
          "table",
          "id",
          "values"
        ],
        "properties": {
          "world": {
            "type": "string"
          },
          "table": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "idless": {
            "description": "The table has no id column (a join table), so the row is written without one and torn down with its organisation.",
            "type": "boolean"
          },
          "deferred": {
            "description": "Columns that name a row written later (a forward reference). They are planned as null in values, and seed --apply sets them to these values by id once every row is written; teardown clears them before deleting.",
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "world",
          "role",
          "email",
          "id"
        ],
        "properties": {
          "world": {
            "$ref": "common.schema.json#/$defs/FileId"
          },
          "role": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "email": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "id": {
            "$ref": "common.schema.json#/$defs/Text"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/Text"
          }
        }
      }
    },
    "staggered": {
      "description": "R9: groups of rows whose relative times named the same moment, made distinct by a second each in file order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "world",
          "table",
          "column",
          "rows"
        ],
        "properties": {
          "world": {
            "type": "string"
          },
          "table": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    "schema": {
      "description": "Fix 9: each planned table's columns and their hash when the plan was written; seed --check refuses a plan whose tables changed since.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hash",
          "columns"
        ],
        "properties": {
          "hash": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
